  "phrases": [
    {
      "start": 0,
      "end": 3.17175,
      "text": "هل اقترب العلم من تغيير مستقبل علاج السكري؟"
    },
    {
      "start": 3.74175,
      "end": 5.82585,
      "text": "سؤال يشغل المرضى وأسرهم"
    },
    {
      "start": 6.27704,
      "end": 8.64185,
      "text": "ويواصل الباحثون البحث عن إجابته"
    },
    {
      "start": 8.88412,
      "end": 10.3583,
      "text": "خطوة بعد خطوة"
    },
    {
      "start": 10.9174,
      "end": 12.234,
      "text": "خلال السنوات الأخيرة"
    },
    {
      "start": 12.458,
      "end": 16.7146,
      "text": "فتحت أبحاث الخلايا الجذعية آفاقًا جديدة تستحق الاهتمام"
    },
    {
      "start": 17.1717,
      "end": 19.1738,
      "text": "لكن بين نتيجة واعدة"
    },
    {
      "start": 19.441,
      "end": 21.9403,
      "text": "وعلاج تثبت سلامته وفعاليته"
    },
    {
      "start": 22.201,
      "end": 25.5067,
      "text": "مراحل من البحث والتجارب لا يمكن تجاوزها"
    },
    {
      "start": 25.924,
      "end": 29.5768,
      "text": "ومع كل اكتشاف جديد تظهر أسئلة أكثر أهمية"
    },
    {
      "start": 29.9716,
      "end": 31.6381,
      "text": "ما الذي أثبته العلم بالفعل؟"
    },
    {
      "start": 32.0322,
      "end": 33.8736,
      "text": "وما الذي لا يزال قيد البحث؟"
    },
    {
      "start": 34.2852,
      "end": 36.7702,
      "text": "بين الأمل العلمي والوعود المتداولة"
    },
    {
      "start": 37.0171,
      "end": 39.775,
      "text": "تأتي أهمية المعرفة المبنية على الدليل"
    },
    {
      "start": 40.2063,
      "end": 43.5131,
      "text": "وهذه الأسئلة يناقشها الباحث في كتابه المرتقب"
    },
    {
      "start": 44.5799,
      "end": 45.188,
      "text": "السكري"
    },
    {
      "start": 45.7895,
      "end": 47.4713,
      "text": "هل اقتربت نهاية المرض؟"
    }
  ]
}